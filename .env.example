# Vapi
VAPI_WEBHOOK_SECRET=         # optional, for signature verification

# Google
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Twilio
TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM_NUMBER=          # the Twilio number SMS will send from, E.164

# OpenAI (not used in v1, but include for forward compat)
OPENAI_API_KEY=

# Customer config (single-tenant for now)
CUSTOMER_NAME=               # e.g., "Acme Restoration"
CUSTOMER_ON_CALL_PHONE=      # E.164, where dispatch SMS goes
CUSTOMER_SERVICE_CENTER_LAT= # float
CUSTOMER_SERVICE_CENTER_LNG= # float
CUSTOMER_SERVICE_RADIUS_MI=  # int, e.g., 30
CUSTOMER_OWNER_PHONE=        # E.164, for escalations or daily summary
CUSTOMER_VAPI_ASSISTANT_ID=  # Vapi assistant ID for customer #1 (used to route webhooks)
CUSTOMER_VAPI_ASSISTANT_ID=  # Vapi assistant ID for this customer

# Database
DATABASE_PATH=./data/dispatcher.db
